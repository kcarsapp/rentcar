model Car {
    id                  String                @id @unique @default(uuid(7))
    serial              Int                   @default(autoincrement())
    carId               String                @unique @default(cuid(2))
    title               String                @db.VarChar(200)
    feature             Feature?
    companyId           String
    rate                Float                 @default(0)
    review              Int                   @default(0)
    trips               Int                   @default(0)
    location            CarLocation?
    company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
    available           Boolean               @default(true)
    brandId             String?
    brand               Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
    typeId              String?
    type                CarType?              @relation(fields: [typeId], references: [id], onDelete: Cascade)
    viewed              Int                   @default(0)
    contact             String?
    displayPlan         RentalPeriodType      @default(hourly)
    listedAt            DateTime              @default(now())
    pinned              Boolean               @default(false)
    pinnedSort          Int?
    featuredCars        FeaturedCars?
    favorite            FavoriteCars[]
    promotion           Promotion[]
    rentalPlan          RentalPlan[]
    images              Image[]
    books               Book[]
    deletedAt           DateTime?
    reviews             CarReview[]
    promotionRedemption PromotionRedemption[]
    usedPromotion       UsedPromotion[]
    recentlyViewed      RecentlyViewedCar[]
    carReviewFlag       CarReviewFlag[]
    slider              Slider[]
    viewedCars          ViewedCars[]
    contactStatistic    ContactStatistic[]

    @@index([companyId])
    @@index([companyId, carId])
    @@index([carId])
    @@index([brandId])
    @@index([typeId])
    @@index([serial])
    @@index([rate])
    @@index([review])
    @@index([review, rate])
    @@index([id, pinned])
    @@index([carId, pinned])
    @@index([listedAt])
    @@index([id, available, pinned])
    @@map("car")
    @@schema("car")
}

model Feature {
    id           String       @id @unique @default(uuid(7))
    seat         Int
    hp           Int?
    speed        Int?
    engCC        Float?
    year         Int?
    odometer     Int?
    cylinders    Int?
    brandId      String?
    brand        Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
    transmission Transmission @default(automatic)
    fuel         Fuel         @default(diesel)
    carTypeId    String?
    type         CarType?     @relation(fields: [carTypeId], references: [id])
    carId        String       @unique
    car          Car          @relation(fields: [carId], references: [id], onDelete: Cascade)
    deletedAt    DateTime?

    @@index([carId])
    @@index([carTypeId])
    @@map("feature")
    @@schema("car")
}

model Image {
    id        String    @id @unique @default(uuid(7))
    image     String
    sort      Int
    companyId String
    company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
    carId     String
    car       Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
    deletedAt DateTime?

    @@index([carId])
    @@index([companyId])
    @@index([carId, companyId])
    @@map("image")
    @@schema("car")
}

model CarType {
    id        String    @id @default(uuid(7))
    en        String
    ar        String?
    ku        String?
    sort      Int
    feature   Feature[]
    car       Car[]
    available Boolean   @default(true)
    deletedAt DateTime?

    @@map("carType")
    @@schema("car")
}

model CarReview {
    id            String         @id @unique @default(uuid(7))
    serial        Int            @default(autoincrement())
    reviewId      String?        @default(cuid(2))
    userId        String?
    desc          String         @db.Text()
    rate          Int
    carId         String?
    car           Car?           @relation(fields: [carId], references: [id], onDelete: SetNull)
    profile       Profile?       @relation(fields: [userId], references: [userId], onDelete: SetNull)
    status        ReviewStatus   @default(pending)
    deletedAt     DateTime?
    canceledAt    DateTime?
    Book          Book?          @relation(fields: [bookId], references: [id])
    companyId     String?
    company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
    bookId        String?
    reviewedAt    DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    CarReviewFlag CarReviewFlag?

    @@index([userId])
    @@index([reviewId])
    @@index([carId])
    @@index([companyId])
    @@index([companyId, carId])
    @@index([bookId])
    @@map("carReview")
    @@schema("car")
}

model Brand {
    id        String    @id @unique @default(uuid(7))
    en        String
    ar        String?
    ku        String?
    image     String?
    sort      Int
    deletedAt DateTime?
    available Boolean   @default(true)
    brand     Feature[]
    cars      Car[]

    @@index([deletedAt])
    @@schema("car")
}

model FeaturedCars {
    id        String    @id @default(uuid(7))
    carId     String?   @unique
    car       Car?      @relation(fields: [carId], references: [id])
    sort      Int       @default(0)
    companyId String?
    company   Company?  @relation(fields: [companyId], references: [id])
    startAt   DateTime  @default(now())
    until     DateTime?
    deletedAt DateTime?
    available Boolean   @default(true)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@index([carId])
    @@index([companyId])
    @@index([companyId, carId])
    @@index([until])
    @@index([startAt])
    @@index([startAt, until])
    @@index([deletedAt, available, sort, startAt, until])
    @@index([deletedAt, available])
    @@index([available])
    @@map("featuredCar")
    @@schema("car")
}

model FavoriteCars {
    id       String   @id @unique @default(uuid(7))
    userId   String?
    carId    String?
    car      Car?     @relation(fields: [carId], references: [id], onDelete: Cascade)
    profile  Profile? @relation(fields: [userId], references: [userId], onDelete: SetNull)
    postedAt DateTime @default(now())

    @@unique([carId, userId])
    @@index([userId])
    @@index([carId])
    @@map("favoriteCars")
    @@schema("car")
}

model RecentlyViewedCar {
    id        String   @id @unique @default(uuid(7))
    userId    String
    profile   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
    carId     String
    car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
    companyId String?
    company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
    viewedAt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, carId])
    @@index([userId])
    @@index([userId, carId])
    @@index([userId, viewedAt])
    @@map("recentlyViewedCar")
    @@schema("car")
}

model ViewedCars {
    id        String   @id @unique @default(uuid(7))
    userId    String?
    profile   Profile? @relation(fields: [userId], references: [userId], onDelete: Cascade)
    companyId String?
    company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
    carId     String
    car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
    ipAddress String?
    viewedAt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([companyId])
    @@index([carId])
    @@index([viewedAt])
    @@map("viewedCars")
    @@schema("car")
}

model CarReviewFlag {
    id        String       @id @default(uuid(7))
    serial    Int          @default(autoincrement())
    companyId String
    reviewId  String       @unique
    flaggedAt DateTime     @default(now())
    status    ReviewStatus @default(flagged)
    carId     String?
    deletedAt DateTime?
    car       Car?         @relation(fields: [carId], references: [id], onDelete: Cascade)
    company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
    review    CarReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

    @@unique([companyId, reviewId])
    @@map("carReviewFlag")
    @@schema("car")
}
