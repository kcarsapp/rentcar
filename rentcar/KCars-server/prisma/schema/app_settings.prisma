model Support {
    id        String    @id @default(uuid(7))
    en        String
    ku        String
    ar        String
    content   String
    image     String?
    sort      Int?
    deletedAt DateTime?
    available Boolean   @default(true)
    postedAt  DateTime? @default(now())

    @@index([sort])
    @@map("support")
    @@schema("appSetting")
}

model Notification {
    id            String   @id @unique @default(uuid(7)) @db.VarChar(50)
    kuTitle       String   @db.Text()
    arTitle       String   @db.Text()
    enTitle       String   @db.Text()
    kuDescription String   @db.Text()
    arDescription String   @db.Text()
    enDescription String   @db.Text()
    postedAt      DateTime @default(now())

    @@index([postedAt])
    @@map("notification")
    @@schema("appSetting")
}

model Slider {
    id        String    @id @unique @default(uuid(7))
    carId     String?
    car       Car?      @relation(fields: [carId], references: [id], onDelete: SetNull)
    companyId String?
    company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
    url       String?
    image     String?
    sort      Int?
    clicked   Int       @default(0)
    type      SlideType @default(url)
    available Boolean   @default(true)
    deletedAt DateTime?
    createdAt DateTime  @default(now())

    @@index([carId])
    @@index([companyId])
    @@index([sort])
    @@index([deletedAt])
    @@schema("appSetting")
}
