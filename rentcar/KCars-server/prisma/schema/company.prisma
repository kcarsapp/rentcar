model Company {
    id                  String                @id @unique @default(uuid(7))
    serial              Int                   @default(autoincrement())
    companyId           String                @default(cuid(2))
    name                String
    desc                String?               @db.Text()
    image               String?               @db.VarChar(1000)
    coverImage          String?
    userId              String                @unique
    profile             Profile?              @relation(fields: [userId], references: [userId])
    activeDate          DateTime              @default(now())
    expiresAt           DateTime
    rate                Float                 @default(0)
    review              Int                   @default(0)
    available           Boolean               @default(true)
    joinedAt            DateTime              @default(now())
    location            Location?
    contact             String?
    contacted           Int                   @default(0)
    international       Boolean               @default(false)
    delivery            Boolean               @default(false)
    companyPlans        CompanyPlans[]
    contacts            Contact[]
    cars                Car[]
    carlocation         CarLocation[]
    carImage            Image[]
    books               Book[]
    promotions          Promotion[]
    reviews             CompanyReview[]
    promotionRedemption PromotionRedemption[]
    usedPromotion       UsedPromotion[]
    companyReviewFlag   CompanyReviewFlag[]
    carReviewFlag       CarReviewFlag[]
    companyStatus       CompanyStatus[]
    carReview           CarReview[]
    rentalPlan          RentalPlan[]
    contactStatistic    ContactStatistic[]
    sldier              Slider[]
    recentlyViewedCar   RecentlyViewedCar[]
    viewedCars          ViewedCars[]
    featuredCars        FeaturedCars[]

    @@index([userId])
    @@index([companyId])
    @@index([serial])
    @@index([userId, companyId])
    @@index([rate, review])
    @@index([review])
    @@index([rate])
    @@index([expiresAt])
    @@index([activeDate])
    @@map("company")
    @@schema("company")
}

model Contact {
    id         String       @id @unique @default(uuid(7))
    countrCode String?
    value      String
    companyId  String
    company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
    type       ContactTypes @default(phone)
    available  Boolean      @default(true)
    clikced    Int          @default(0)
    sort       Int?
    deletedAt  DateTime?

    @@index([companyId])
    @@index([type])
    @@map("contact")
    @@schema("company")
}

model CompanyReview {
    id                String             @id @unique @default(uuid(7))
    serial            Int                @default(autoincrement())
    reviewId          String?            @default(cuid(2))
    desc              String             @db.Text()
    rate              Int
    companyId         String?
    company           Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
    userId            String?
    profile           Profile?           @relation(fields: [userId], references: [userId], onDelete: SetNull)
    status            ReviewStatus       @default(pending)
    canceledAt        DateTime?
    reviewedAt        DateTime           @default(now())
    updatedAt         DateTime           @updatedAt
    deletedAt         DateTime?
    companyReviewFlag CompanyReviewFlag?

    @@index([companyId])
    @@index([userId])
    @@index([reviewId])
    @@index([reviewId, userId])
    @@index([reviewId, companyId])
    @@map("companyReview")
    @@schema("company")
}

model CompanyReviewFlag {
    id        String        @id @default(uuid(7))
    reviewId  String        @unique
    serial    Int           @default(autoincrement())
    status    ReviewStatus  @default(flagged)
    deletedAt DateTime?
    flaggedAt DateTime      @default(now())
    companyId String
    company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
    review    CompanyReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

    @@unique([companyId, reviewId])
    @@index([reviewId])
    @@index([status])
    @@map("companyReviewFlag")
    @@schema("company")
}

model CompanyStatus {
    id        String          @id @unique @default(uuid(7))
    comanyId  String?
    company   Company?        @relation(fields: [comanyId], references: [id], onDelete: SetNull)
    status    CompanyStatuses @default(live)
    reason    String?         @db.Text()
    postedAt  DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    @@index([comanyId])
    @@index([status])
    @@map("companyStatus")
    @@schema("company")
}

model CompanyPlans {
    id         String   @id @unique @default(uuid(7))
    companyId  String?  @unique
    String     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
    activeDate DateTime
    expiresAt  DateTime
    postedAt   DateTime @default(now())

    @@index([companyId])
    @@schema("company")
}

model ContactStatistic {
    id        String       @id @unique @default(uuid(7))
    contactId String?
    userId    String?
    profile   Profile?     @relation(fields: [userId], references: [userId], onDelete: SetNull)
    companyId String?
    company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
    carId     String?
    car       Car?         @relation(fields: [carId], references: [id], onDelete: SetNull)
    type      ContactTypes
    value     String?
    ipAddress String?
    createdAt DateTime     @default(now())

    @@index([userId])
    @@index([contactId])
    @@index([ipAddress])
    @@index([companyId])
    @@index([type])
    @@index([value])
    @@index([createdAt])
    @@map("contactStatistic")
    @@schema("company")
}
