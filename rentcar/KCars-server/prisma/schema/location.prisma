model Location {
    id         String                                 @id @unique @default(uuid())
    lat        Float                                  @db.DoublePrecision
    long       Float                                  @db.DoublePrecision
    companyId  String                                 @unique
    Company    Company                                @relation(fields: [companyId], references: [id], onDelete: Cascade)
    townId     String?
    town       Town?                                  @relation(fields: [townId], references: [id])
    radiusKm   Int?
    cityId     String?
    city       City?                                  @relation(fields: [cityId], references: [id])
    pglocation Unsupported("geography(Point, 4326)")?
    createdAt  DateTime                               @default(now())
    deletedAt  DateTime?

    @@unique([id, companyId])
    @@index([cityId])
    @@index([radiusKm])
    @@index([lat])
    @@index([long])
    @@map("location")
    @@schema("location")
}

model CarLocation {
    id        String                                 @id @unique @default(uuid())
    lat       Float                                  @db.DoublePrecision
    long      Float                                  @db.DoublePrecision
    companyId String
    Company   Company                                @relation(fields: [companyId], references: [id], onDelete: Cascade)
    townId    String?
    town      Town?                                  @relation(fields: [townId], references: [id], onDelete: SetNull)
    carId     String?                                @unique
    car       Car?                                   @relation(fields: [carId], references: [id], onDelete: Cascade)
    radiusKm  Int?
    cityId    String?
    city      City?                                  @relation(fields: [cityId], references: [id], onDelete: SetNull)
    location  Unsupported("geography(Point, 4326)")?
    createdAt DateTime                               @default(now())
    deletedAt DateTime?

    @@index([radiusKm])
    @@index([lat])
    @@index([long])
    @@index([carId])
    @@index([townId])
    @@index([cityId])
    @@map("carLocation")
    @@schema("location")
}

model City {
    id          String                                 @id @unique @default(uuid(7))
    en          String
    ku          String
    ar          String
    lat         Float?                                 @db.DoublePrecision
    long        Float?                                 @db.DoublePrecision
    radiusKm    Int?
    sort        Int?
    location    Location[]
    pglocation  Unsupported("geography(Point, 4326)")?
    carLocation CarLocation[]
    towns       Town[]
    available   Boolean                                @default(true)
    deletedAt   DateTime?

    @@index([radiusKm])
    @@index([lat])
    @@index([long])
    @@map("city")
    @@schema("location")
}

model Town {
    id          String                                 @id @unique @default(uuid(7))
    en          String
    ku          String
    ar          String
    lat         Float?                                 @db.DoublePrecision
    long        Float?                                 @db.DoublePrecision
    radiusKm    Int?
    cityId      String
    city        City                                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
    sort        Int?
    pglocation  Unsupported("geography(Point, 4326)")?
    location    Location[]
    carLocation CarLocation[]
    available   Boolean                                @default(true)
    deletedAt   DateTime?

    @@index([radiusKm])
    @@index([lat])
    @@index([long])
    @@index([cityId])
    @@map("town")
    @@schema("location")
}
